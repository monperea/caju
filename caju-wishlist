  margin-top:12px;
  padding:9px 12px;
  border-radius:13px;
  background:#FFF7EA;
  color:#776E67;
  font-size:11px;
  text-align:center;
}

#caju-wl .wl-count.wl-show{display:block;}

/* ---------- REVIEW ---------- */
#caju-wl .wl-review{
