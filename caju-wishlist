  overflow:hidden;
  text-overflow:ellipsis;
  margin-bottom:3px;
}

#caju-wl .wl-name{
  font-size:12px;
  line-height:1.35;
  font-weight:600;
  min-height:33px;
}

#caju-wl .wl-price{
  font-size:12px;
  font-weight:600;
  margin:6px 0 8px;
}

#caju-wl .wl-add{
