  grid-template-columns:1fr 1fr;
  gap:7px;
  padding:0 14px;
}

#caju-wl .wl-progress span{
  height:5px;
  background:#F1E8D3;
  border-radius:99px;
}

#caju-wl .wl-progress span.wl-on{background:var(--cj-orange);}

#caju-wl .wl-screen{
  display:none;
  padding:18px 16px 16px;
  animation:wlIn .28s ease;
}

#caju-wl .wl-screen.wl-act{display:block;}

@keyframes wlIn{
  from{opacity:0;transform:translateY(10px);}
  to{opacity:1;transform:translateY(0);}
}

#caju-wl .wl-question{
  margin:0 0 5px;
  font-size:24px;
  line-height:1.25;
  font-weight:650;
}

#caju-wl .wl-help{
  margin:0 0 17px;
  color:#8A817A;
  font-size:13px;
  line-height:1.45;
}

/* ---------- CHOICE SCREEN ---------- */
#caju-wl .wl-choice-stack{
  display:grid;
  gap:10px;
  margin-top:10px;
}

#caju-wl .wl-choice{
  width:100%;
  text-align:left;
  border:1.5px solid #E8DCC0;
  border-radius:17px;
  background:#FFFDF8;
  padding:14px 15px;
  cursor:pointer;
  font-family:"Poppins",sans-serif;
  color:var(--cj-dark);
  transition:.18s ease;
}

#caju-wl .wl-choice:hover{
  border-color:var(--cj-orange);
  transform:translateY(-1px);
}

#caju-wl .wl-choice-title{
  display:block;
  font-size:15px;
  font-weight:650;
  margin-bottom:3px;
}

#caju-wl .wl-choice-copy{
  display:block;
  font-size:12px;
  line-height:1.4;
  color:#8A817A;
  font-weight:400;
}

/* ---------- FORM ---------- */
#caju-wl .wl-field{margin-bottom:11px;}

#caju-wl .wl-label{
  display:block;
  font-size:12px;
  font-weight:600;
  margin-bottom:5px;
}

#caju-wl .wl-label em{
  font-style:normal;
  font-weight:400;
  color:#A49B93;
}

#caju-wl .wl-input{
  display:block;
  width:100%;
  border:1.5px solid #E8DCC0;
  border-radius:13px;
  background:#FFFDF8;
  color:var(--cj-dark);
  padding:11px 12px;
  font:400 13px/1.3 "Poppins",sans-serif;
  outline:none;
}

#caju-wl .wl-input:focus{border-color:var(--cj-orange);}

#caju-wl .wl-add-manual{
  width:100%;
  border:0;
  border-radius:999px;
  background:var(--cj-orange);
  color:white;
  padding:13px 16px;
  font:600 13px/1 "Poppins",sans-serif;
  cursor:pointer;
  margin-top:2px;
}

#caju-wl .wl-error{
  display:none;
  color:var(--cj-red);
  font-size:11px;
  margin-top:7px;
}

#caju-wl .wl-error.wl-show{display:block;}

/* ---------- COUNTRY CHIPS ---------- */
#caju-wl .wl-chips{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:9px 0 16px;
}

#caju-wl .wl-chip{
  border:1.5px solid #E8DCC0;
  border-radius:28px;
  background:#FFFDF8;
  color:var(--cj-dark);
  padding:8px 14px;
  font:400 13px/1 "Poppins",sans-serif;
  cursor:pointer;
}

#caju-wl .wl-chip[aria-pressed="true"]{
  border-color:var(--cj-orange);
  color:var(--cj-orange);
  font-weight:600;
}

/* ---------- PRODUCTS ---------- */
#caju-wl .wl-products{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}

#caju-wl .wl-empty{
  grid-column:1/-1;
  text-align:center;
  padding:24px 10px;
  color:#9A918A;
  font-size:12px;
}

#caju-wl .wl-card{
  overflow:hidden;
  border:1.5px solid var(--cj-cream);
  border-radius:16px;
  background:white;
}

#caju-wl .wl-img{
  width:100%;
  aspect-ratio:1/1;
  overflow:hidden;
  background:#FBF2DC;
}

#caju-wl .wl-img .wl-product-photo{
  width:100%!important;
  height:100%!important;
  object-fit:cover!important;
  display:block;
}

#caju-wl .wl-img.wl-placeholder{
  display:flex;
  align-items:center;
  justify-content:center;
}

#caju-wl .wl-placeholder-logo{
  width:68px!important;
  height:68px!important;
  object-fit:contain!important;
  opacity:.22!important;
}

#caju-wl .wl-card-body{padding:9px;}

#caju-wl .wl-store{
