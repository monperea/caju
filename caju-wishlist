  justify-content:space-between;
  gap:10px;
  margin-top:15px;
}

#caju-wl .wl-back{
  border:0;
  background:transparent;
  color:#9A928B;
  font:400 12px/1 "Poppins",sans-serif;
  cursor:pointer;
  padding:8px 0;
}

#caju-wl .wl-next{
  display:none;
  border:0;
  border-radius:999px;
  background:var(--cj-orange);
  color:white;
  padding:10px 14px;
  font:600 12px/1 "Poppins",sans-serif;
  cursor:pointer;
}

#caju-wl .wl-next.wl-show{display:inline-block;}

#caju-wl .wl-count{
