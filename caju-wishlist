  border:1.5px solid var(--cj-orange);
  border-radius:999px;
  background:white;
  color:var(--cj-orange);
  padding:7px 8px;
  font:600 11px/1 "Poppins",sans-serif;
  cursor:pointer;
}

#caju-wl .wl-add.wl-added{
  background:var(--cj-orange);
  color:white;
}

/* ---------- NAV + LIST COUNTER ---------- */
#caju-wl .wl-nav{
  display:flex;
