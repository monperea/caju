var country="";
var selected=[];
var customItems=[];
var customSeq=1;

var root=document.getElementById("caju-wl");
var welcome=root.querySelector("#wl-welcome");
var flow=root.querySelector("#wl-flow");
var products=root.querySelector("#wl-products");
var review=root.querySelector("#wl-review");
var customName=root.querySelector("#wl-custom-name");
var customUrl=root.querySelector("#wl-custom-url");
var customError=root.querySelector("#wl-custom-error");

root.querySelectorAll("[data-logo]").forEach(function(img){img.src=LOGO;});

function esc(str){
  return String(str)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;");
}

function getProduct(id){
  for(var i=0;i<P.length;i++) if(P[i].id===id) return P[i];
  return null;
}

function money(p){
  if(p.cu==="COP"){
    return "$"+Number(p.pr).toLocaleString("es-CO",{maximumFractionDigits:0})+" COP";
  }
  return "$"+Number(p.pr).toLocaleString("es-EC",{minimumFractionDigits:2,maximumFractionDigits:2})+" USD";
}

function totalItems(){return selected.length+customItems.length;}

function normalizeUrl(v){
  v=String(v||"").trim();
  if(!v) return "";
  if(!/^https?:\/\//i.test(v)) v="https://"+v;
  return v;
}

function showScreen(name){
  root.querySelectorAll(".wl-screen").forEach(function(s){s.classList.remove("wl-act");});
  var s=root.querySelector('[data-screen="'+name+'"]');
  if(s) s.classList.add("wl-act");

  root.querySelectorAll("[data-prog]").forEach(function(p){
    p.classList.toggle("wl-on", name==="review" ? true : p.getAttribute("data-prog")==="1");
  });

  updateCounts();
  flow.scrollIntoView({behavior:"smooth",block:"start"});
}

function updateCounts(){
  var n=totalItems();
  var txt=n ? "🛒 "+n+(n===1?" artículo en tu lista":" artículos en tu lista") : "";
  root.querySelectorAll(".wl-count").forEach(function(el){
    el.textContent=txt;
    el.classList.toggle("wl-show",n>0);
  });
  root.querySelectorAll("[data-review]").forEach(function(btn){
    btn.classList.toggle("wl-show",n>0);
  });
}

function mediaHTML(p){
  if(!p.im){
    return '<div class="wl-img wl-placeholder"><img class="wl-placeholder-logo" src="'+LOGO+'" alt="Cajú"></div>';
  }
  return '<div class="wl-img"><img class="wl-product-photo" src="'+esc(p.im)+'" alt="'+esc(p.nm)+'" loading="lazy"></div>';
}

function renderProducts(){
  if(!country){
    products.innerHTML='<div class="wl-empty">Selecciona un país para ver productos.</div>';
    return;
  }

  var list=P.filter(function(p){return p.co===country;});

  products.innerHTML=list.map(function(p){
    var added=selected.indexOf(p.id)!==-1;
    return '<article class="wl-card">'+
      mediaHTML(p)+
      '<div class="wl-card-body">'+
        '<span class="wl-store">'+esc(p.st)+'</span>'+
        '<div class="wl-name">'+esc(p.nm)+'</div>'+
        '<div class="wl-price">'+money(p)+'</div>'+
        '<button class="wl-add'+(added?' wl-added':'')+'" data-add="'+p.id+'">'+(added?'✓ Agregado':'+ Agregar')+'</button>'+
      '</div>'+
    '</article>';
  }).join("");

  products.querySelectorAll(".wl-product-photo").forEach(function(img){
    img.addEventListener("error",function(){
      var box=img.parentNode;
      box.classList.add("wl-placeholder");
      box.innerHTML='<img class="wl-placeholder-logo" src="'+LOGO+'" alt="Cajú">';
    },{once:true});
  });
}

function renderReview(){
  var html="";

  customItems.forEach(function(item){
    html+='<div class="wl-review-item wl-manual">'+
      '<div>'+
        '<div class="wl-rname">'+esc(item.name)+'</div>'+
        (item.url?'<a class="wl-rurl" href="'+esc(item.url)+'" target="_blank" rel="noopener noreferrer">'+esc(item.url)+'</a>':'')+
      '</div>'+
      '<button class="wl-remove" data-remove-custom="'+item.id+'" aria-label="Quitar">✕</button>'+
    '</div>';
  });

  selected.forEach(function(id){
    var p=getProduct(id);
    if(!p) return;
    var media=p.im
      ? '<div class="wl-review-thumb"><img src="'+esc(p.im)+'" alt=""></div>'
      : '<div class="wl-review-thumb wl-placeholder"><img src="'+LOGO+'" alt=""></div>';

    html+='<div class="wl-review-item">'+
      media+
      '<div>'+
        '<div class="wl-rname">'+esc(p.nm)+'</div>'+
        '<div class="wl-rmeta">'+money(p)+'</div>'+
      '</div>'+
      '<button class="wl-remove" data-remove="'+p.id+'" aria-label="Quitar">✕</button>'+
    '</div>';
  });

  review.innerHTML=html || '<div class="wl-empty">Tu lista está vacía.</div>';

  review.querySelectorAll(".wl-review-thumb img").forEach(function(img){
    img.addEventListener("error",function(){
      var box=img.parentNode;
      box.classList.add("wl-placeholder");
      box.innerHTML='<img src="'+LOGO+'" alt="Cajú">';
    },{once:true});
  });
}

root.querySelector("#wl-start").addEventListener("click",function(){
  welcome.style.display="none";
  flow.classList.add("wl-open");
  showScreen("choice");
});

root.querySelectorAll("[data-go]").forEach(function(btn){
  btn.addEventListener("click",function(){
    showScreen(btn.getAttribute("data-go"));
  });
});

root.querySelector("[data-home]").addEventListener("click",function(){
  flow.classList.remove("wl-open");
  welcome.style.display="block";
  welcome.scrollIntoView({behavior:"smooth",block:"start"});
});

root.querySelector("#wl-custom-add").addEventListener("click",function(){
  var name=customName.value.trim();
  var url=normalizeUrl(customUrl.value);

  if(!name){
    customError.classList.add("wl-show");
    customName.focus();
    return;
  }

  customError.classList.remove("wl-show");
  customItems.push({id:"custom-"+(customSeq++),name:name,url:url});
  customName.value="";
  customUrl.value="";
  updateCounts();

  root.querySelector("#wl-custom-add").textContent="✓ Añadido";
  setTimeout(function(){
    root.querySelector("#wl-custom-add").textContent="+ Añadir a mi lista";
  },1100);
});

customName.addEventListener("input",function(){
  if(customName.value.trim()) customError.classList.remove("wl-show");
});

root.querySelectorAll("[data-country]").forEach(function(btn){
  btn.addEventListener("click",function(){
    country=btn.getAttribute("data-country");
    root.querySelectorAll("[data-country]").forEach(function(b){
      b.setAttribute("aria-pressed",b===btn?"true":"false");
    });
    renderProducts();
  });
});

products.addEventListener("click",function(e){
  var btn=e.target.closest("[data-add]");
  if(!btn) return;
  var id=btn.getAttribute("data-add");
  var pos=selected.indexOf(id);
  if(pos===-1) selected.push(id);
  else selected.splice(pos,1);
  renderProducts();
  updateCounts();
});

root.querySelectorAll("[data-review]").forEach(function(btn){
  btn.addEventListener("click",function(){
    if(totalItems()===0) return;
    renderReview();
    showScreen("review");
  });
});

review.addEventListener("click",function(e){
  var c=e.target.closest("[data-remove-custom]");
  if(c){
    var cid=c.getAttribute("data-remove-custom");
    customItems=customItems.filter(function(x){return x.id!==cid;});
    renderReview();
    updateCounts();
    if(totalItems()===0) showScreen("choice");
    return;
  }

  var b=e.target.closest("[data-remove]");
  if(b){
    var id=b.getAttribute("data-remove");
    var pos=selected.indexOf(id);
    if(pos!==-1) selected.splice(pos,1);
    renderProducts();
    renderReview();
    updateCounts();
    if(totalItems()===0) showScreen("choice");
  }
});

root.querySelector("#wl-whatsapp").addEventListener("click",function(){
  var note=root.querySelector("#wl-note").value.trim();
  var msg="¡Hola! 🧡 He creado mi lista de deseos en Cajú para que sepas qué me gustaría recibir.\n\nMírala aquí: "+SHARE;
  if(note) msg+="\n\nMi nota: "+note;
  window.open("https://wa.me/?text="+encodeURIComponent(msg),"_blank","noopener");
});

root.querySelector("#wl-copy").addEventListener("click",function(){
  var btn=this;
  function done(){
    btn.textContent="¡Copiado! ✓";
    setTimeout(function(){btn.textContent="Copiar enlace";},2000);
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(SHARE).then(done).catch(done);
  }else{
    var t=document.createElement("textarea");
    t.value=SHARE;
    document.body.appendChild(t);
    t.select();
    try{document.execCommand("copy");}catch(e){}
    document.body.removeChild(t);
    done();
  }
});

updateCounts();

})();
</script>

