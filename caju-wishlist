  color:#746D67;
}

#caju-wl .wl-main-cta{
  border:0;
  border-radius:999px;
  background:var(--cj-orange);
  color:white;
  font:600 17px/1 "Poppins",sans-serif;
  padding:17px 30px;
  cursor:pointer;
  min-width:260px;
}

/* ---------- MAIN PANEL ---------- */
#caju-wl .wl-flow{
  display:none;
  overflow:hidden;
