  background:#FBF2DC;
  display:flex;
  align-items:center;
  justify-content:center;
}

#caju-wl .wl-review-thumb img{
  width:100%!important;
  height:100%!important;
  object-fit:cover!important;
}

#caju-wl .wl-review-thumb.wl-placeholder img{
  width:26px!important;
  height:26px!important;
  object-fit:contain!important;
  opacity:.22!important;
}

#caju-wl .wl-rname{
  font-size:11px;
  font-weight:600;
